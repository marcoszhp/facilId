{
  "name": "@facilid/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node ../scripts/expo.mjs start --dev-client",
    "web": "node ../scripts/expo.mjs start --web",
    "android": "node ../scripts/expo.mjs run:android",
    "android:prepare": "node ../scripts/expo.mjs prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "build": "node ../scripts/expo.mjs export --platform web",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "expo": "~54.0.37",
    "expo-dev-client": "~6.0.20",
    "expo-camera": "~17.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0",
    "react-native-svg": "15.12.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-nfc-manager": "3.17.2",
    "react-native-tts": "4.1.1",
    "react-native-haptic-feedback": "3.0.0",
    "axios": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
