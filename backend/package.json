{
  "name": "@facilid/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsc && node ../scripts/backend-dev.mjs",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "generate-keys": "tsc && node dist/services/assinatura.service.js",
    "seed": "tsc && node dist/db/seed.js",
    "test": "jest --runInBand",
    "test:mysql": "jest --runInBand --testMatch \"**/tests/**/*.mysql.ts\"",
    "db:setup": "tsc && node dist/db/cli.js setup",
    "db:check": "tsc && node dist/db/cli.js check",
    "db:migrate": "tsc && node dist/db/cli.js migrate"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
