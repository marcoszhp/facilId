# Copie para backend/.env. Esse arquivo privado não entra no Git.
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=facilid
# root sem senha é apenas o padrão de desenvolvimento local do XAMPP.
# Se houver senha, preencha DB_PASSWORD entre aspas neste arquivo local.
DB_USER=root
DB_PASSWORD=""
DATA_DIR=.local
PORT=3000
HOST=127.0.0.1
# Para demonstração explicitamente sem banco: DB_CLIENT=json
# Não exponha o MySQL/XAMPP nem esta chave administrativa na Internet.
