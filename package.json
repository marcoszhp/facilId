{
  "name": "facilid-acessosenior",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "mobile"
  ],
  "scripts": {
    "setup": "npm run generate-keys -w backend && npm run seed -w backend",
    "dev": "npm run dev -w backend",
    "mobile": "npm run start -w mobile",
    "web": "npm run web -w mobile",
    "test": "npm run test --workspaces",
    "check": "node scripts/verify.mjs",
    "check:watch": "node scripts/verify.mjs --watch",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces"
  },
  "allowScripts": {
    "@scarf/scarf": true,
    "esbuild": true
  }
}
